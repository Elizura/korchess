FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies including platform-specific ones
RUN npm install

# Store node_modules in a separate location for the entrypoint
RUN cp -r node_modules /tmp/node_modules_cache

EXPOSE 3000

# On startup, ensure node_modules exists (for volume mount scenarios)
CMD sh -c "if [ ! -d /app/node_modules/next ]; then cp -r /tmp/node_modules_cache/* /app/node_modules/ 2>/dev/null || true; fi && npm run dev -- --hostname 0.0.0.0"
