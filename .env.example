# =============================================================================
# REQUIRED - Application will fail to start without these
# =============================================================================

# Database connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret for authentication (use a secure random string)
JWT_SECRET=your-secure-jwt-secret-here

# Redis URL for Celery task queue
REDIS_URL=redis://redis:6379/0

# =============================================================================
# REQUIRED FOR PRODUCTION FRONTEND BUILD
# =============================================================================

# Frontend API URL (baked into Next.js at build time)
# This is the PUBLIC URL users will access
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com

# =============================================================================
# GOOGLE OAUTH (required if using Google Sign-In)
# =============================================================================

# Google OAuth Client ID (backend)
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Google OAuth Client ID (frontend - same value as GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# =============================================================================
# OPTIONAL - Feature-specific or have sensible defaults
# =============================================================================

# Email service (required only if email verification is enabled)
RESEND_API_KEY=

# AI Features (required only if AI insights are enabled)
GEMINI_API_KEY=

# SSL Certificate (for certbot in production)
CERTBOT_EMAIL=

# Analytics (optional - disabled if not set)
ANALYTICS_HASH_SALT=
ANALYTICS_ENABLED=true
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_IPINFO_TOKEN=
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# LMDB Cache path on host (for Lichess eval database volume mount)
LICHESS_EVAL_DB_HOST_PATH=/path/to/lmdb/cache

# =============================================================================
# PERFORMANCE TUNING (optional - have sensible defaults in code)
# =============================================================================

# DB_POOL_MIN=2
# DB_POOL_MAX=10
# ENGINE_POOL_SIZE=2
# FULL_ANALYSIS_POSITION_WORKERS=1
# FULL_ANALYSIS_ENGINE_THREADS=2
# FULL_ANALYSIS_ENGINE_HASH_MB=128
