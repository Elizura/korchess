# =============================================================================
# REQUIRED - Application will fail to start without these
# =============================================================================

# Database connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret for authentication (use a secure random string)
JWT_SECRET=your-secure-jwt-secret-here

# Redis URL for Celery task queue
REDIS_URL=redis://redis:6379/0

# =============================================================================
# REQUIRED FOR PRODUCTION FRONTEND BUILD
# =============================================================================

# Frontend API URL (baked into Next.js at build time)
# This is the PUBLIC URL users will access
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com

# =============================================================================
# GOOGLE OAUTH (required if using Google Sign-In)
# =============================================================================

# Google OAuth Client ID (backend)
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Google OAuth Client ID (frontend - same value as GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# =============================================================================
# OPTIONAL - Feature-specific or have sensible defaults
# =============================================================================

# Email (required for email/password sign-up and password reset; Google
# sign-in works without it). FROM_EMAIL must be an address on a domain you
# have verified in Resend: the default onboarding@resend.dev sender only
# delivers to the Resend account owner, so other users never get their code.
RESEND_API_KEY=
FROM_EMAIL=Korchess <noreply@your-domain.com>

# AI Features (required only if AI insights are enabled)
GEMINI_API_KEY=

# SSL Certificate (for certbot in production)
CERTBOT_EMAIL=

# Analytics (optional - disabled if not set)
ANALYTICS_HASH_SALT=
ANALYTICS_ENABLED=true
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_IPINFO_TOKEN=
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Lichess eval cache (optional LMDB built from the Lichess eval dump with
# `python -m lmdb_magic.ingest`, see backend/lmdb_magic/ingest.py). Positions
# found in it skip Stockfish.
# Host directory mounted read-only at /app/lmdb_cache. When unset it defaults
# to ./lmdb_cache, an empty placeholder, and the app runs without the cache.
# LICHESS_EVAL_DB_HOST_PATH=/path/to/lmdb/cache
# Path the backend reads the cache from (default /app/lmdb_cache). Compose
# sets it to the container mount point; only change it when running the
# backend outside Docker.
# LICHESS_EVAL_DB_PATH=/app/lmdb_cache

# Lichess API token (optional - for higher rate limits)
LICHESS_API_TOKEN=

# =============================================================================
# PERFORMANCE TUNING (optional - have sensible defaults in code)
# =============================================================================

# DB_POOL_MIN=2
# DB_POOL_MAX=10
# ENGINE_POOL_SIZE=2
# FULL_ANALYSIS_POSITION_WORKERS=1
# FULL_ANALYSIS_ENGINE_THREADS=2
# FULL_ANALYSIS_ENGINE_HASH_MB=128
